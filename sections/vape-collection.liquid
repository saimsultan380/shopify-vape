  .vcp-check {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    cursor: pointer;
    font-size: 0.875rem;
    color: #333;
  }
  .vcp-check.is-muted { color: #bbb; }
  .vcp-check input { position: absolute; opacity: 0; pointer-events: none; }
  .vcp-check__box {
    width: 16px;
    height: 16px;
    border: 1.5px solid #bbb;
    border-radius: 2px;
    flex-shrink: 0;
