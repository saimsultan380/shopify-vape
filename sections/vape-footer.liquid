{%- comment -%}
  ============================================================
  Vape Footer — sections/vape-footer.liquid
  Matches reference: brand/contact + 3 link columns,
  copyright / social / payment cards / back-to-top
  ============================================================
{%- endcomment -%}

{% style %}
  #shopify-section-{{ section.id }} {
    --vf-bg: {{ section.settings.background }};
    --vf-heading: {{ section.settings.heading_color }};
    --vf-text: {{ section.settings.text_color }};
    --vf-muted: {{ section.settings.muted_color }};
    --vf-border: {{ section.settings.border_color }};
    padding-block-start: {{ section.settings.padding_top }}px;
    padding-block-end: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
  }
{% endstyle %}

<footer id="vf-{{ section.id }}" class="vf" data-vape-footer>
  <div class="vf__inner">
    <div class="vf__grid">
      {%- comment -%} Brand + contact {%- endcomment -%}
      <div class="vf__brand">
        <a href="{{ routes.root_url }}" class="vf__logo" aria-label="{{ shop.name | escape }}">
          {%- if section.settings.logo != blank -%}
            {{
              section.settings.logo
              | image_url: width: 360
              | image_tag:
                loading: 'lazy',
                widths: '160, 220, 280, 360',
                sizes: '160px',
                alt: shop.name,
                class: 'vf__logo-img'
            }}
          {%- elsif settings.logo != blank -%}
            {{
              settings.logo
              | image_url: width: 360
              | image_tag:
                loading: 'lazy',
                widths: '160, 220, 280, 360',
                sizes: '160px',
                alt: shop.name,
                class: 'vf__logo-img'
            }}
          {%- else -%}
            <span class="vf__logo-mark" aria-hidden="true">
              <svg width="72" height="72" viewBox="0 0 72 72" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M18 44c0-2 1-4 3-5l6-3c2-1 3-3 3-5v-4c0-3 2-6 5-7 2-1 4-1 6 0 3 1 5 4 5 7v4c0 2 1 4 3 5l6 3c2 1 3 3 3 5v4H18v-4z" fill="#111"/>
                <path d="M28 28c2-8 6-14 14-18 1 5 2 10 1 15" stroke="#111" stroke-width="2.2" stroke-linecap="round"/>
                <path d="M34 24c1-5 3-9 8-12" stroke="#111" stroke-width="1.8" stroke-linecap="round" opacity="0.55"/>
                <rect x="40" y="30" width="6" height="16" rx="2" fill="#111"/>
                <path d="M43 30v-4" stroke="#111" stroke-width="2" stroke-linecap="round"/>
                <circle cx="43" cy="24" r="2" fill="#111"/>
                <path d="M22 48h28c2 0 4 2 4 4v2H18v-2c0-2 2-4 4-4z" fill="#111"/>
              </svg>
            </span>
            <span class="vf__logo-text">{{ section.settings.brand_name | default: shop.name | upcase | escape }}</span>
          {%- endif -%}
        </a>

        <ul class="vf__contact" role="list">
          {%- if section.settings.address != blank -%}
            <li>
              <span class="vf__contact-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </span>
              <span>{{ section.settings.address | escape }}</span>
            </li>
          {%- endif -%}

          {%- if section.settings.phone != blank -%}
            <li>
              <span class="vf__contact-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </span>
              <a href="tel:{{ section.settings.phone | replace: ' ', '' | escape }}">{{ section.settings.phone | escape }}</a>
            </li>
          {%- endif -%}

          {%- if section.settings.email != blank -%}
            <li>
              <span class="vf__contact-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </span>
              <a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>
            </li>
          {%- endif -%}
        </ul>
      </div>

      {%- comment -%} Menu columns {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div class="vf__col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="vf__col-title">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="vf__links" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a href="{{ link.url }}">{{ link.title | escape }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              <ul class="vf__links" role="list">
                {%- if block.settings.link_1_label != blank -%}
                  <li><a href="{{ block.settings.link_1_url | default: '#' }}">{{ block.settings.link_1_label | escape }}</a></li>
                {%- endif -%}
                {%- if block.settings.link_2_label != blank -%}
                  <li><a href="{{ block.settings.link_2_url | default: '#' }}">{{ block.settings.link_2_label | escape }}</a></li>
                {%- endif -%}
                {%- if block.settings.link_3_label != blank -%}
                  <li><a href="{{ block.settings.link_3_url | default: '#' }}">{{ block.settings.link_3_label | escape }}</a></li>
                {%- endif -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="vf__bottom">
      <p class="vf__copy">
        {%- if section.settings.copyright_text != blank -%}
          {{ section.settings.copyright_text | escape }}
        {%- else -%}
          Copyright © {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. All rights reserved.
        {%- endif -%}
      </p>

      <ul class="vf__social" role="list" aria-label="Social media">
        {%- if section.settings.facebook_url != blank -%}
          <li>
            <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12.07C22 6.48 17.52 2 11.93 2S2 6.48 2 12.07c0 5.02 3.66 9.18 8.44 9.93v-7.02H7.9v-2.91h2.54V9.84c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.75 8.44-4.91 8.44-9.93z"/></svg>
            </a>
          </li>
        {%- endif -%}
        {%- if section.settings.instagram_url != blank -%}
          <li>
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
              </svg>
            </a>
          </li>
        {%- endif -%}
        {%- if section.settings.twitter_url != blank -%}
          <li>
            <a href="{{ section.settings.twitter_url }}" target="_blank" rel="noopener" aria-label="X">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/></svg>
            </a>
          </li>
        {%- endif -%}
        {%- if section.settings.pinterest_url != blank -%}
          <li>
            <a href="{{ section.settings.pinterest_url }}" target="_blank" rel="noopener" aria-label="Pinterest">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.5 2 2 6.5 2 12c0 4.2 2.6 7.8 6.3 9.2-.1-.8-.2-2 0-2.9.2-.8 1.3-5.5 1.3-5.5s-.3-.7-.3-1.6c0-1.5.9-2.6 2-2.6.9 0 1.4.7 1.4 1.5 0 .9-.6 2.3-.9 3.5-.3 1.1.5 1.9 1.5 1.9 1.8 0 3.2-1.9 3.2-4.6 0-2.4-1.7-4.1-4.2-4.1-2.9 0-4.5 2.1-4.5 4.3 0 .9.3 1.8.8 2.3.1.1.1.2.1.3l-.3 1.2c0 .2-.1.2-.3.1-1.3-.6-2.1-2.5-2.1-4 0-3.3 2.4-6.3 6.8-6.3 3.6 0 6.4 2.6 6.4 6 0 3.6-2.3 6.5-5.4 6.5-1.1 0-2.1-.6-2.4-1.2l-.7 2.5c-.2.9-.9 2-1.3 2.7.1 0 .2.1.3.1C17.6 21.3 22 17.1 22 12c0-5.5-4.5-10-10-10z"/></svg>
            </a>
          </li>
        {%- endif -%}
      </ul>

      <div class="vf__payments-wrap">
        <ul class="vf__payments" role="list" aria-label="Payment methods">
          <li class="vf__pay vf__pay--apple" aria-label="Apple Pay">
            <svg viewBox="0 0 52 32" width="52" height="32" xmlns="http://www.w3.org/2000/svg" role="img">
              <rect x="0.5" y="0.5" width="51" height="31" rx="4" fill="#fff" stroke="#D8D8D8"/>
              <path d="M15.1 10.1c-.55.65-1.4 1.1-2.25 1.05-.1-.85.3-1.75.85-2.3.6-.65 1.6-1.1 2.4-1.15.05.9-.25 1.8-1 2.4zm1.05 1c-1.25-.05-2.3.7-2.9.7-.6 0-1.55-.7-2.55-.65-1.3.05-2.5.75-3.15 1.95-1.35 2.3-.35 5.75.95 7.65.7.95 1.5 1.95 2.55 1.9.8 0 1.4-.65 2.55-.65s1.55.65 2.6.6c1.1 0 1.75-.95 2.4-1.9.8-1.1 1.05-2.15 1.1-2.2-.05 0-1.95-.75-1.95-2.95 0-1.85 1.5-2.7 1.6-2.75-.9-1.3-2.25-1.45-2.7-1.5z" fill="#111"/>
              <text x="22" y="20" font-family="Arial, Helvetica, sans-serif" font-size="11" font-weight="500" fill="#111">Pay</text>
            </svg>
          </li>
          <li class="vf__pay vf__pay--discover" aria-label="Discover">
            <svg viewBox="0 0 52 32" width="52" height="32" xmlns="http://www.w3.org/2000/svg" role="img">
              <rect x="0.5" y="0.5" width="51" height="31" rx="4" fill="#fff" stroke="#D8D8D8"/>
              <text x="5" y="13" font-family="Arial, Helvetica, sans-serif" font-size="6.5" font-weight="700" fill="#111" letter-spacing="0.4">DISCOVER</text>
              <path d="M20 18.5c0 0 6.5 5 18 5 7.5 0 12-2.5 12-2.5H20z" fill="#F76B1C"/>
              <circle cx="38" cy="21" r="5.5" fill="#F76B1C"/>
            </svg>
          </li>
          <li class="vf__pay vf__pay--mastercard" aria-label="Mastercard">
            <svg viewBox="0 0 52 32" width="52" height="32" xmlns="http://www.w3.org/2000/svg" role="img">
              <rect x="0.5" y="0.5" width="51" height="31" rx="4" fill="#fff" stroke="#D8D8D8"/>
              <circle cx="21" cy="16" r="8.5" fill="#EB001B"/>
              <circle cx="31" cy="16" r="8.5" fill="#F79E1B"/>
              <path d="M26 9.2a8.5 8.5 0 0 1 0 13.6 8.5 8.5 0 0 1 0-13.6z" fill="#FF5F00"/>
            </svg>
          </li>
          <li class="vf__pay vf__pay--visa" aria-label="Visa">
            <svg viewBox="0 0 52 32" width="52" height="32" xmlns="http://www.w3.org/2000/svg" role="img">
              <rect width="52" height="32" rx="4" fill="#1A1F71"/>
              <path d="M22.2 21.2h-2.5l1.55-9.5h2.5l-1.55 9.5zm10.55-9.25c-.5-.2-1.3-.4-2.25-.4-2.5 0-4.25 1.3-4.25 3.2 0 1.4 1.3 2.15 2.25 2.6 1 .5 1.3.8 1.3 1.25 0 .65-.8 1-1.55 1-.95 0-1.5-.15-2.3-.5l-.3 1.5c.5.2 1.45.4 2.45.4 2.65 0 4.35-1.3 4.4-3.3.05-2.5-3.35-2.65-3.3-3.7.05-.35.35-.95 1.55-.95.65 0 1.3.15 1.8.3l.25-1.4zm6.55 9.25h2.2l-1.9-9.5h-2.05c-.45 0-.85.25-1.05.65l-3.65 8.85h2.55l.5-1.4h3.15l.25 1.4zm-2.75-3.25l1.3-3.55.75 3.55h-2.05zm-13.9-6.25l-2.5 9.5h-2.45l-1.2-6.55c-.05-.3-.15-.45-.45-.55-.55-.2-1.45-.45-2.25-.6l.05-.35h3.85c.5 0 .95.35 1.05.9l.95 5.15 2.4-6.05h2.55z" fill="#fff"/>
            </svg>
          </li>
        </ul>

        {%- if section.settings.show_shop_payments -%}
          <ul class="vf__payments vf__payments--shop" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'vf__shop-pay-icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.show_back_to_top -%}
          <button type="button" class="vf__top" data-vf-top aria-label="Back to top">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="18 15 12 9 6 15"></polyline>
            </svg>
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

<style>
  .vf {
    width: 100%;
    background: var(--vf-bg, #f2f2f2);
    color: var(--vf-text, #555);
    font-family: var(--vape-font-primary, 'Inter', system-ui, sans-serif);
  }

  .vf__inner {
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
    padding-inline: var(--vape-page-padding, clamp(1rem, 4vw, 3.5rem));
  }

  .vf__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 2.75rem;
  }

  @media (min-width: 750px) {
    .vf__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 2.5rem;
    }
  }

  @media (min-width: 990px) {
    .vf__grid {
      grid-template-columns: 1.35fr 1fr 1fr 1fr;
      gap: 2.5rem;
      align-items: start;
    }
  }

  /* Brand */
  .vf__logo {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    text-decoration: none;
    color: var(--vf-heading, #111);
    margin-bottom: 1.35rem;
  }

  .vf__logo-img {
    display: block;
    max-width: 140px;
    height: auto;
  }

  .vf__logo-mark {
    display: block;
    line-height: 0;
  }

  .vf__logo-text {
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #111;
    line-height: 1;
  }

  .vf__contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .vf__contact li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--vf-text, #555);
  }

  .vf__contact a {
    color: inherit;
    text-decoration: none;
  }
  .vf__contact a:hover { color: var(--vape-accent, #e53935); }

  .vf__contact-icon {
    flex: 0 0 18px;
    width: 18px;
    color: #888;
    display: inline-flex;
    margin-top: 0.1rem;
  }

  /* Columns */
  .vf__col-title {
    margin: 0 0 1.15rem;
    font-size: 0.95rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--vf-heading, #111);
  }

  .vf__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .vf__links a {
    font-size: 0.9rem;
    color: var(--vf-text, #555);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .vf__links a:hover { color: var(--vape-accent, #e53935); }

  /* Bottom bar */
  .vf__bottom {
    border-top: 1px solid var(--vf-border, #e0e0e0);
    padding-top: 1.35rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: center;
  }

  @media (min-width: 990px) {
    .vf__bottom {
      grid-template-columns: minmax(0, 1.2fr) auto minmax(0, 1.2fr);
      gap: 1.5rem;
    }
  }

  .vf__copy {
    margin: 0;
    font-size: 0.8rem;
    color: var(--vf-muted, #999);
  }

  @media (min-width: 990px) {
    .vf__copy { justify-self: start; }
  }

  .vf__social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
  }

  .vf__social a {
    color: #666;
    display: inline-flex;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .vf__social a:hover {
    color: #111;
    transform: translateY(-1px);
  }

  .vf__payments-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  @media (min-width: 990px) {
    .vf__payments-wrap { justify-content: flex-end; }
  }

  .vf__payments {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .vf__payments--shop { display: none; }

  .vf__pay {
    line-height: 0;
    display: inline-flex;
  }

  .vf__pay svg {
    display: block;
    width: 50px;
    height: 31px;
    border-radius: 4px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
  }

  .vf__shop-pay-icon {
    height: 24px;
    width: auto;
  }

  .vf__top {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 0;
    background: #4a4a4a;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    margin-left: 0.25rem;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .vf__top:hover {
    background: #111;
    transform: translateY(-2px);
  }

  @media (max-width: 989px) {
    .vf__bottom {
      text-align: center;
    }
    .vf__copy { order: 3; }
    .vf__social { order: 1; }
    .vf__payments-wrap { order: 2; }
  }
</style>

<script>
(function () {
  const root = document.getElementById('vf-{{ section.id }}');
  if (!root) return;
  root.querySelector('[data-vf-top]')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
})();
</script>

{% schema %}
{
  "name": "Vape Footer",
  "tag": "section",
  "class": "section-vape-footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Brand & contact"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name (if no logo)",
      "default": "VAPEHUB"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "2357 Gordon Street, CA"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+909 478 2742"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "vapehub@example.com"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "Copyright © 2024 Vinovathemes. All rights reserved."
    },
    {
      "type": "text",
      "id": "facebook_url",
      "label": "Facebook URL",
      "default": "https://www.facebook.com/"
    },
    {
      "type": "text",
      "id": "instagram_url",
      "label": "Instagram URL",
      "default": "https://www.instagram.com/"
    },
    {
      "type": "text",
      "id": "twitter_url",
      "label": "X / Twitter URL",
