<script>
(function () {
  const root = document.getElementById('vpp-{{ section.id }}');
  if (!root) return;

  /* ── Gallery ── */
  const slides = Array.from(root.querySelectorAll('[data-vpp-slide]'));
  const thumbs = Array.from(root.querySelectorAll('[data-vpp-thumb]'));
  let activeIndex = 0;

  function showSlide(index) {
    if (!slides.length) return;
    activeIndex = (index + slides.length) % slides.length;
    slides.forEach((slide, i) => {
      const on = i === activeIndex;
      slide.classList.toggle('is-active', on);
      slide.hidden = !on;
    });
    thumbs.forEach((thumb, i) => {
      const on = i === activeIndex;
      thumb.classList.toggle('is-active', on);
      thumb.setAttribute('aria-selected', on ? 'true' : 'false');
    });
  }

  thumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => showSlide(parseInt(thumb.dataset.index, 10)));
  });
  root.querySelector('[data-vpp-prev]')?.addEventListener('click', () => showSlide(activeIndex - 1));
  root.querySelector('[data-vpp-next]')?.addEventListener('click', () => showSlide(activeIndex + 1));

  /* ── Quantity ── */
  const qtyInput = root.querySelector('[data-vpp-qty-input]');
  root.querySelector('[data-vpp-qty-minus]')?.addEventListener('click', () => {
    const v = parseInt(qtyInput.value, 10) || 1;
    if (v > 1) qtyInput.value = v - 1;
  });
  root.querySelector('[data-vpp-qty-plus]')?.addEventListener('click', () => {
    const v = parseInt(qtyInput.value, 10) || 1;
    qtyInput.value = v + 1;
  });

  /* ── Flash sale countdown ── */
  const flash = root.querySelector('[data-vpp-flash]');
  if (flash && flash.dataset.end) {
    const end = new Date(flash.dataset.end.replace(' ', 'T')).getTime();
    const hEl = flash.querySelector('[data-vpp-h]');
    const mEl = flash.querySelector('[data-vpp-m]');
    const sEl = flash.querySelector('[data-vpp-s]');
    if (!isNaN(end)) {
      const tick = () => {
        const diff = Math.max(0, end - Date.now());
        const h = Math.floor(diff / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        const s = Math.floor((diff % 60000) / 1000);
        if (hEl) hEl.textContent = String(h).padStart(2, '0');
        if (mEl) mEl.textContent = String(m).padStart(2, '0');
        if (sEl) sEl.textContent = String(s).padStart(2, '0');
        if (diff <= 0) clearInterval(timer);
      };
      tick();
      const timer = setInterval(tick, 1000);
    }
  }

  /* ── Tabs ── */
  const tabs = root.querySelectorAll('[data-tab]');
  const panels = root.querySelectorAll('[data-panel]');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const id = tab.dataset.tab;
      tabs.forEach((t) => {
        const on = t === tab;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      panels.forEach((panel) => {
        const on = panel.dataset.panel === id;
        panel.classList.toggle('is-active', on);
        panel.hidden = !on;
      });
    });
  });

  root.querySelector('[data-vpp-ask]')?.addEventListener('click', (e) => {
    e.preventDefault();
    const customTab = root.querySelector('[data-tab="custom"]');
    customTab?.click();
    root.querySelector('#vpp-tabs-{{ section.id }}')?.scrollIntoView({ behavior: 'smooth' });
  });

  /* ── Share ── */
  root.querySelector('[data-vpp-share]')?.addEventListener('click', async () => {
    const btn = root.querySelector('[data-vpp-share]');
    const shareData = { title: btn.dataset.title, url: btn.dataset.url };
    try {
      if (navigator.share) {
        await navigator.share(shareData);
      } else {
        await navigator.clipboard.writeText(shareData.url);
        btn.textContent = 'Link copied';
        setTimeout(() => { btn.innerHTML = btn.dataset.original || 'Share'; }, 1500);
      }
    } catch (err) { /* user cancelled */ }
  });

  /* ── Variant selection ── */
  const variantsJson = root.parentElement.querySelector('[data-vpp-variants-json]') || document.querySelector('#shopify-section-{{ section.id }} [data-vpp-variants-json]');
  let variants = [];
  try {
    variants = JSON.parse((variantsJson && variantsJson.textContent) || '[]');
  } catch (e) { variants = []; }

  const variantInput = root.querySelector('[data-vpp-variant-input]');
  const priceSale = root.querySelector('[data-vpp-price-sale]');
  const priceCompare = root.querySelector('[data-vpp-price-compare]');
  const discountEl = root.querySelector('[data-vpp-discount]');
  const skuEl = root.querySelector('[data-vpp-sku]');
  const availEl = root.querySelector('[data-vpp-availability]');
  const atcBtn = root.querySelector('[data-vpp-atc]');
  const atcText = root.querySelector('[data-vpp-atc-text]');
  const moneyFormat = {{ shop.money_format | json }};

  function formatMoney(cents) {
    const amount = (cents / 100).toFixed(2);
    if (typeof Shopify !== 'undefined' && Shopify.formatMoney) {
      return Shopify.formatMoney(cents, moneyFormat);
    }
    return moneyFormat.replace(/\{\{\s*amount\s*\}\}/, amount)
      .replace(/\{\{\s*amount_no_decimals\s*\}\}/, String(Math.round(cents / 100)))
      .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/, amount.replace('.', ','));
  }

  function getSelectedOptions() {
    const selected = {};
    root.querySelectorAll('[data-vpp-option]:checked').forEach((input) => {
      selected[parseInt(input.dataset.optionPosition, 10)] = input.value;
    });
    return selected;
  }

  function findVariant() {
    const selected = getSelectedOptions();
    return variants.find((v) => {
      return v.options.every((opt, i) => selected[i + 1] === opt);
    });
  }

  function updateVariantUI() {
    const variant = findVariant();
    if (!variant) return;

    if (variantInput) variantInput.value = variant.id;
    root.dataset.variantId = variant.id;

    if (priceSale) priceSale.textContent = formatMoney(variant.price);

    const onSale = variant.compare_at_price && variant.compare_at_price > variant.price;
    if (priceCompare) {
      priceCompare.textContent = onSale ? formatMoney(variant.compare_at_price) : '';
      priceCompare.classList.toggle('is-hidden', !onSale);
    }
    if (discountEl) {
      if (onSale) {
        const pct = Math.round(((variant.compare_at_price - variant.price) / variant.compare_at_price) * 100);
        discountEl.textContent = '-' + pct + '%';
      }
      discountEl.classList.toggle('is-hidden', !onSale);
    }

    if (skuEl) skuEl.textContent = variant.sku || 'N/A';

    if (availEl) {
      availEl.textContent = variant.available ? 'In stock, ready to ship' : 'Out of stock';
      availEl.classList.toggle('is-in', variant.available);
      availEl.classList.toggle('is-out', !variant.available);
    }

    if (atcBtn) atcBtn.disabled = !variant.available;
    if (atcText) atcText.textContent = variant.available ? 'ADD TO CART' : 'SOLD OUT';

    /* Update swatch selected state */
    root.querySelectorAll('.vpp-swatch').forEach((label) => {
      const input = label.querySelector('input');
      label.classList.toggle('is-selected', !!(input && input.checked));
    });

    /* Sync featured image if variant has one */
    if (variant.featured_media || variant.featured_image) {
      const mediaId = variant.featured_media ? variant.featured_media.id : null;
      if (mediaId) {
        const thumb = thumbs.find((t) => {
          /* thumbs are ordered by product.media; try match via index from media */
          return false;
        });
      }
      const imgSrc = variant.featured_image;
      if (imgSrc) {
        const matchIndex = slides.findIndex((slide) => {
          const img = slide.querySelector('img');
          return img && imgSrc.src && img.src.includes(String(imgSrc.id || ''));
        });
        /* Prefer matching by product media position stored on variant */
        if (variant.featured_image && typeof variant.featured_image.position === 'number') {
          showSlide(Math.max(0, variant.featured_image.position - 1));
        }
      }
    }

    const url = new URL(window.location.href);
    url.searchParams.set('variant', variant.id);
    window.history.replaceState({}, '', url.toString());
  }

  root.querySelectorAll('[data-vpp-option]').forEach((input) => {
    input.addEventListener('change', updateVariantUI);
  });

  /* ── Add to cart ── */
  const form = root.querySelector('.vpp-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!atcBtn || atcBtn.disabled) return;

    const formData = new FormData(form);
    atcBtn.classList.add('is-loading');

    fetch(window.Shopify?.routes?.root ? window.Shopify.routes.root + 'cart/add.js' : '/cart/add.js', {
      method: 'POST',
      headers: { Accept: 'application/json' },
      body: formData
    })
      .then((res) => res.json())
      .then((data) => {
        atcBtn.classList.remove('is-loading');
        if (data.status) {
          alert(data.description || data.message || 'Could not add to cart');
          return;
        }
        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
        document.dispatchEvent(new CustomEvent('cart:open', { bubbles: true }));
        /* Open cart drawer if present */
        const drawer = document.querySelector('cart-drawer-component, cart-drawer, [data-cart-drawer]');
        if (drawer) {
          if (typeof drawer.open === 'function') drawer.open();
          else drawer.setAttribute('open', '');
        }
      })
      .catch(() => {
        atcBtn.classList.remove('is-loading');
        alert('Could not add to cart. Please try again.');
      });
  });
})();
</script>

