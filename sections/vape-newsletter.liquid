{%- comment -%}
  ============================================================
  Vape Newsletter — sections/vape-newsletter.liquid
  Centered subscribe block matching the reference design:
  envelope icon · uppercase heading · underline email + submit
  ============================================================
{%- endcomment -%}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-block-start: {{ section.settings.padding_top }}px;
    padding-block-end: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
  }
{% endstyle %}

<div id="vnl-{{ section.id }}" class="vnl">
  <div class="vnl__inner">
    {%- if section.settings.show_icon -%}
      <div class="vnl__icon" aria-hidden="true">
        <svg width="56" height="40" viewBox="0 0 56 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 14H14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          <path d="M0 20H12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          <path d="M2 26H14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          <rect x="16" y="8" width="38" height="24" rx="2" stroke="currentColor" stroke-width="1.8"/>
          <path d="M16.5 10.5L35 22.5L54.5 10.5" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        </svg>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="vnl__heading" style="color: {{ section.settings.heading_color }};">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="vnl__subheading" style="color: {{ section.settings.subheading_color }};">
        {{ section.settings.subheading | escape }}
      </p>
    {%- endif -%}

    {%- assign vnl_form_id = 'vnl-form-' | append: section.id -%}
    {%- form 'customer', class: 'vnl__form', id: vnl_form_id -%}
      <input type="hidden" name="contact[tags]" value="newsletter">

      <div class="vnl__row">
        <div class="vnl__field">
          <label class="visually-hidden" for="vnl-email-{{ section.id }}">Email</label>
          <input
            id="vnl-email-{{ section.id }}"
            class="vnl__input"
            type="email"
            name="contact[email]"
            value="{% if customer %}{{ customer.email }}{% endif %}"
            placeholder="{{ section.settings.placeholder | escape }}"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
            {% if form.errors %}aria-invalid="true"{% endif %}
          >
        </div>

        <button type="submit" class="vnl__submit">
          <span>{{ section.settings.button_label | escape }}</span>
          <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
            <path d="M1 7H17M17 7L11 1M17 7L11 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      {%- if form.errors -%}
        <p class="vnl__message vnl__message--error" role="alert">
          {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
        </p>
      {%- endif -%}

      {%- if form.posted_successfully? -%}
        <p class="vnl__message vnl__message--success" role="status">
          {{ section.settings.success_message | escape }}
        </p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

<style>
  .vnl {
    width: 100%;
    font-family: var(--vape-font-primary, 'Inter', system-ui, sans-serif);
  }

  .vnl__inner {
    max-width: 720px;
    margin: 0 auto;
    padding-inline: var(--vape-page-padding, clamp(1rem, 4vw, 3.5rem));
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .vnl__icon {
    color: #111;
    margin-bottom: 1.35rem;
    display: flex;
    justify-content: center;
  }

  .vnl__heading {
    margin: 0 0 0.85rem;
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.2;
    color: #111;
  }

  .vnl__subheading {
    margin: 0 0 2.25rem;
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.55;
    color: #222;
    max-width: 34rem;
  }

  .vnl__form {
    width: 100%;
    max-width: 560px;
  }

  .vnl__row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem;
    align-items: end;
  }

  @media (max-width: 575px) {
    .vnl__row {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  .vnl__field {
    min-width: 0;
  }

  .vnl__input {
    width: 100%;
    border: 0 !important;
    border-bottom: 1px solid #cfcfcf !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    padding: 0.55rem 0 !important;
    font-size: 0.9rem !important;
    color: #111 !important;
    font-family: inherit;
    outline: none !important;
  }

  .vnl__input::placeholder {
    color: #b0b0b0 !important;
    font-weight: 400;
  }

  .vnl__input:focus {
    border-bottom-color: #111 !important;
    box-shadow: none !important;
  }

  .vnl__submit {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: none;
    border: 0;
    border-bottom: 1px solid #111;
    border-radius: 0;
    padding: 0.55rem 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: #111;
    cursor: pointer;
    white-space: nowrap;
    font-family: inherit;
    transition: color 0.2s ease, border-color 0.2s ease, gap 0.2s ease;
  }

  .vnl__submit:hover {
    color: var(--vape-accent, #e53935);
    border-bottom-color: var(--vape-accent, #e53935);
    gap: 0.75rem;
  }

  .vnl__submit svg {
    flex-shrink: 0;
  }

  .vnl__message {
    margin: 0.85rem 0 0;
    font-size: 0.85rem;
  }

  .vnl__message--error { color: #e53935; }
  .vnl__message--success { color: #2e7d32; }

  .visually-hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

{% schema %}
{
  "name": "Vape Newsletter",
  "tag": "section",
  "class": "section-vape-newsletter",
  "enabled_on": {
    "groups": ["footer"],
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show envelope icon",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SUBSCRIBE TO OUR NEWSLETTER"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get Exclusive Discounts and Deals Delivered Straight to Your Inbox!"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Enter Your Email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Submit Now"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#222222"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Vape Newsletter",
      "category": "Forms"
    }
  ]
}
{% endschema %}
