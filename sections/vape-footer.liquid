{%- comment -%}
  ============================================================
  Vape Footer — matches VAPEHUB reference design 1:1
  Brand + contact | 3 menu columns
  Copyright | social (center) | payment cards + back-to-top
  ============================================================
{%- endcomment -%}

{% style %}
  #shopify-section-{{ section.id }} {
    --vf-bg: {{ section.settings.background }};
    --vf-heading: {{ section.settings.heading_color }};
    --vf-text: {{ section.settings.text_color }};
    --vf-muted: {{ section.settings.muted_color }};
    --vf-border: {{ section.settings.border_color }};
    --vf-icon: {{ section.settings.icon_color }};
    padding-block-start: {{ section.settings.padding_top }}px;
    padding-block-end: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
  }
{% endstyle %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">

<footer id="vf-{{ section.id }}" class="vf" data-vape-footer>
  <div class="vf__inner">

    {%- comment -%} ── Top: 4 columns ── {%- endcomment -%}
    <div class="vf__grid">

      <div class="vf__brand">
        <a href="{{ routes.root_url }}" class="vf__logo" aria-label="{{ shop.name | escape }}">
          {%- if section.settings.logo != blank -%}
            {{
              section.settings.logo
              | image_url: width: 280
              | image_tag:
                loading: 'lazy',
                widths: '140, 200, 280',
                sizes: '140px',
                alt: shop.name,
                class: 'vf__logo-img'
            }}
          {%- elsif settings.logo != blank -%}
            {{
              settings.logo
              | image_url: width: 280
              | image_tag:
                loading: 'lazy',
                widths: '140, 200, 280',
                sizes: '140px',
                alt: shop.name,
                class: 'vf__logo-img'
            }}
          {%- else -%}
            <span class="vf__logo-mark" aria-hidden="true">
              {%- comment -%} Fist + vape + vapor cloud mark {%- endcomment -%}
              <svg width="78" height="70" viewBox="0 0 78 70" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M39 6c6 0 10 3 12 7 3-1 7 0 9 3 3 3 3 8 1 12 2 1 4 4 4 7 0 5-4 9-9 9H22c-5 0-9-4-9-9 0-3 2-6 4-7-2-4-2-9 1-12 2-3 6-4 9-3 2-4 6-7 12-7z" fill="#111"/>
                <path d="M30 18c2-5 6-8 11-9M44 16c2-3 5-5 9-5" stroke="#fff" stroke-width="1.4" stroke-linecap="round" opacity="0.35"/>
                <path d="M24 42h8l2-6h8l2 6h10v6c0 2-2 4-4 4H28c-2 0-4-2-4-4v-6z" fill="#111"/>
                <path d="M30 36c0-4 3-7 7-7s7 3 7 7" stroke="#111" stroke-width="3" stroke-linecap="round"/>
                <rect x="52" y="28" width="5" height="14" rx="1.5" fill="#111"/>
                <path d="M54.5 28V22" stroke="#111" stroke-width="2.2" stroke-linecap="round"/>
                <circle cx="54.5" cy="20" r="2.2" fill="#111"/>
                <path d="M54.5 16c1-4 4-7 8-8" stroke="#111" stroke-width="1.6" stroke-linecap="round"/>
                <path d="M56 14c0-3 2-5 5-6" stroke="#111" stroke-width="1.2" stroke-linecap="round" opacity="0.55"/>
                <path d="M22 56h34c3 0 5 2 5 4v2H17v-2c0-2 2-4 5-4z" fill="#111"/>
              </svg>
            </span>
            <span class="vf__logo-text">{{ section.settings.brand_name | default: shop.name | upcase | escape }}</span>
          {%- endif -%}
        </a>

        <ul class="vf__contact" role="list">
          {%- if section.settings.address != blank -%}
            <li>
              <span class="vf__contact-icon" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </span>
              <span>{{ section.settings.address | escape }}</span>
            </li>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <li>
              <span class="vf__contact-icon" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.11 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </span>
              <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | escape }}">{{ section.settings.phone | escape }}</a>
            </li>
          {%- endif -%}
          {%- if section.settings.email != blank -%}
            <li>
              <span class="vf__contact-icon" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="4" width="20" height="16" rx="2"/>
                  <path d="M22 7l-10 7L2 7"/>
                </svg>
              </span>
              <a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>
            </li>
          {%- endif -%}
        </ul>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div class="vf__col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="vf__col-title">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            <ul class="vf__links" role="list">
              {%- if block.settings.menu != blank -%}
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              {%- else -%}
                {%- if block.settings.link_1_label != blank -%}
                  <li><a href="{{ block.settings.link_1_url | default: '#' }}">{{ block.settings.link_1_label | escape }}</a></li>
                {%- endif -%}
                {%- if block.settings.link_2_label != blank -%}
                  <li><a href="{{ block.settings.link_2_url | default: '#' }}">{{ block.settings.link_2_label | escape }}</a></li>
                {%- endif -%}
                {%- if block.settings.link_3_label != blank -%}
                  <li><a href="{{ block.settings.link_3_url | default: '#' }}">{{ block.settings.link_3_label | escape }}</a></li>
                {%- endif -%}
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} ── Bottom bar ── {%- endcomment -%}
    <div class="vf__bottom">
      <p class="vf__copy">
        {%- if section.settings.copyright_text != blank -%}
          {{ section.settings.copyright_text | escape }}
        {%- else -%}
          Copyright © {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. All rights reserved.
        {%- endif -%}
      </p>

      <ul class="vf__social" role="list" aria-label="Social media">
        {%- if section.settings.facebook_url != blank -%}
          <li>
            <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8h3V5h-3c-2.8 0-5 2.2-5 5v2H6v3h3v7h3v-7h3.1l.9-3H12v-2c0-.6.4-1 1-1z"/></svg>
            </a>
          </li>
        {%- endif -%}
        {%- if section.settings.instagram_url != blank -%}
          <li>
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="1.1" fill="currentColor" stroke="none"/>
              </svg>
            </a>
          </li>
        {%- endif -%}
        {%- if section.settings.twitter_url != blank -%}
          <li>
            <a href="{{ section.settings.twitter_url }}" target="_blank" rel="noopener noreferrer" aria-label="X">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/></svg>
            </a>
          </li>
        {%- endif -%}
        {%- if section.settings.pinterest_url != blank -%}
          <li>
            <a href="{{ section.settings.pinterest_url }}" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.5 2 2 6.5 2 12c0 4.2 2.6 7.8 6.3 9.2-.1-.8-.2-2 0-2.9.2-.8 1.3-5.5 1.3-5.5s-.3-.7-.3-1.6c0-1.5.9-2.6 2-2.6.9 0 1.4.7 1.4 1.5 0 .9-.6 2.3-.9 3.5-.3 1.1.5 1.9 1.5 1.9 1.8 0 3.2-1.9 3.2-4.6 0-2.4-1.7-4.1-4.2-4.1-2.9 0-4.5 2.1-4.5 4.3 0 .9.3 1.8.8 2.3.1.1.1.2.1.3l-.3 1.2c0 .2-.1.2-.3.1-1.3-.6-2.1-2.5-2.1-4 0-3.3 2.4-6.3 6.8-6.3 3.6 0 6.4 2.6 6.4 6 0 3.6-2.3 6.5-5.4 6.5-1.1 0-2.1-.6-2.4-1.2l-.7 2.5c-.2.9-.9 2-1.3 2.7 1 .3 2 .5 3.1.5 5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg>
            </a>
          </li>
        {%- endif -%}
      </ul>

      <div class="vf__payments-wrap">
        <ul class="vf__payments" role="list" aria-label="Payment methods">
          <li class="vf__pay" aria-label="Apple Pay" title="Apple Pay">
            <svg viewBox="0 0 48 30" width="48" height="30" xmlns="http://www.w3.org/2000/svg" role="img">
              <rect x="0.5" y="0.5" width="47" height="29" rx="3.5" fill="#fff" stroke="#D0D0D0"/>
              <path d="M13.6 9.4c-.5.6-1.25 1-2 1-.1-.8.3-1.6.75-2.1.55-.6 1.45-1 2.15-1.05.05.8-.25 1.65-.9 2.15zm.95.95c-1.15-.05-2.1.65-2.65.65s-1.4-.65-2.3-.6c-1.2.05-2.25.7-2.85 1.8-1.25 2.1-.35 5.25.85 7 .65.85 1.35 1.8 2.3 1.75.75 0 1.25-.6 2.3-.6 1.05 0 1.4.6 2.35.55 1 0 1.6-.85 2.2-1.75.7-1 .95-1.95 1-2 0 0-1.8-.7-1.8-2.7 0-1.7 1.4-2.5 1.45-2.5-.8-1.2-2.05-1.35-2.45-1.4z" fill="#111"/>
              <text x="20.5" y="18.5" font-family="Arial, Helvetica, sans-serif" font-size="10" font-weight="500" fill="#111">Pay</text>
            </svg>
          </li>
          <li class="vf__pay" aria-label="Discover" title="Discover">
            <svg viewBox="0 0 48 30" width="48" height="30" xmlns="http://www.w3.org/2000/svg" role="img">
              <rect x="0.5" y="0.5" width="47" height="29" rx="3.5" fill="#fff" stroke="#D0D0D0"/>
              <text x="4.5" y="12" font-family="Arial, Helvetica, sans-serif" font-size="6" font-weight="700" fill="#111" letter-spacing="0.3">DISCOVER</text>
              <ellipse cx="34" cy="19.5" rx="9" ry="5" fill="#F76B1C"/>
            </svg>
          </li>
          <li class="vf__pay" aria-label="Mastercard" title="Mastercard">
            <svg viewBox="0 0 48 30" width="48" height="30" xmlns="http://www.w3.org/2000/svg" role="img">
              <rect x="0.5" y="0.5" width="47" height="29" rx="3.5" fill="#fff" stroke="#D0D0D0"/>
              <circle cx="19.5" cy="15" r="7.5" fill="#EB001B"/>
              <circle cx="28.5" cy="15" r="7.5" fill="#F79E1B"/>
              <path d="M24 8.7a7.5 7.5 0 0 1 0 12.6 7.5 7.5 0 0 1 0-12.6z" fill="#FF5F00"/>
            </svg>
          </li>
          <li class="vf__pay" aria-label="Visa" title="Visa">
            <svg viewBox="0 0 48 30" width="48" height="30" xmlns="http://www.w3.org/2000/svg" role="img">
              <rect width="48" height="30" rx="3.5" fill="#1A1F71"/>
              <text x="8" y="19" font-family="Arial, Helvetica, sans-serif" font-size="11" font-weight="800" font-style="italic" fill="#fff" letter-spacing="1">VISA</text>
            </svg>
          </li>
        </ul>

        {%- if section.settings.show_back_to_top -%}
          <button type="button" class="vf__top" data-vf-top aria-label="Back to top">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="18 15 12 9 6 15"/>
            </svg>
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

<style>
  .section-vape-footer {
    background: var(--vf-bg, #f5f5f5) !important;
  }

  .vf {
    width: 100%;
    background: var(--vf-bg, #f5f5f5);
    color: var(--vf-text, #666);
    font-family: var(--vape-font-primary, 'Inter', system-ui, sans-serif);
  }

  .vf__inner {
    max-width: min(1200px, var(--page-width, 1400px));
    margin: 0 auto;
    padding-inline: var(--vape-page-padding, clamp(1.25rem, 4vw, 3rem));
  }

  /* ── Top grid ── */
  .vf__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.75rem 2rem;
    padding-bottom: 3.25rem;
  }

  @media (min-width: 750px) {
    .vf__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5rem;
      row-gap: 2.75rem;
    }
  }

  @media (min-width: 990px) {
    .vf__grid {
      grid-template-columns: 1.15fr 1fr 1fr 1fr;
      column-gap: 3rem;
      align-items: start;
    }
  }

  /* ── Brand ── */
  .vf__logo {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    text-decoration: none;
    color: var(--vf-heading, #111);
    margin-bottom: 1.5rem;
  }

  .vf__logo-img {
    display: block;
    max-width: 130px;
    height: auto;
  }

  .vf__logo-mark {
    display: block;
    line-height: 0;
    margin-bottom: 0.15rem;
  }

  .vf__logo-mark svg {
    display: block;
    width: 72px;
    height: auto;
  }

  .vf__logo-text {
    font-family: 'Oswald', var(--vape-font-primary, sans-serif);
    font-size: 1.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #111;
    line-height: 1;
  }

  .vf__contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
  }

  .vf__contact li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--vf-text, #666);
    font-weight: 400;
  }

  .vf__contact a {
    color: inherit;
    text-decoration: none;
  }
  .vf__contact a:hover { color: #111; }

  .vf__contact-icon {
    flex: 0 0 16px;
    width: 16px;
    height: 16px;
    color: var(--vf-icon, #8a8a8a);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.15rem;
  }

  /* ── Menu columns ── */
  .vf__col-title {
    margin: 0.35rem 0 1.35rem;
    font-family: 'Oswald', var(--vape-font-primary, sans-serif);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--vf-heading, #111);
    line-height: 1.2;
  }

  .vf__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .vf__links a {
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--vf-text, #666);
    text-decoration: none;
    transition: color 0.2s ease;
    line-height: 1.35;
  }
  .vf__links a:hover { color: #111; }

  /* ── Bottom bar: copyright | social (true center) | payments ── */
  .vf__bottom {
    position: relative;
    border-top: 1px solid var(--vf-border, #e4e4e4);
    padding-top: 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: center;
  }

  @media (min-width: 990px) {
    .vf__bottom {
      grid-template-columns: 1fr auto 1fr;
      gap: 1rem;
      min-height: 48px;
    }
  }

  .vf__copy {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--vf-muted, #9a9a9a);
    line-height: 1.4;
  }

  @media (min-width: 990px) {
    .vf__copy { justify-self: start; }
  }

  .vf__social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.35rem;
  }

  .vf__social a {
    color: #6a6a6a;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .vf__social a:hover {
    color: #111;
    transform: translateY(-1px);
  }

  .vf__payments-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  @media (min-width: 990px) {
    .vf__payments-wrap {
      justify-self: end;
      justify-content: flex-end;
    }
  }

  .vf__payments {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .vf__pay {
    line-height: 0;
    display: inline-flex;
  }

  .vf__pay svg {
    display: block;
    width: 46px;
    height: 29px;
    border-radius: 3px;
  }

  .vf__top {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 0;
    background: #4a4a4a;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    margin-left: 0.35rem;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .vf__top:hover {
    background: #222;
    transform: translateY(-3px);
  }

  @media (max-width: 989px) {
    .vf__bottom { text-align: center; }
    .vf__copy { order: 3; }
    .vf__social { order: 1; }
    .vf__payments-wrap { order: 2; }
  }
</style>

<script>
(function () {
  const root = document.getElementById('vf-{{ section.id }}');
  if (!root) return;
  root.querySelector('[data-vf-top]')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
})();
</script>

{% schema %}
{
  "name": "Vape Footer",
  "tag": "section",
  "class": "section-vape-footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Brand & contact"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo",
      "info": "Upload your VAPEHUB logo for a perfect match. Fallback SVG mark is used if empty."
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name (if no logo)",
      "default": "VAPEHUB"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "2357 Gordon Street, CA"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+909 478 2742"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "vapehub@example.com"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "Copyright © 2024 Vinovathemes. All rights reserved."
    },
    {
      "type": "text",
      "id": "facebook_url",
      "label": "Facebook URL",
      "default": "https://www.facebook.com/"
    },
    {
      "type": "text",
      "id": "instagram_url",
      "label": "Instagram URL",
      "default": "https://www.instagram.com/"
    },
    {
      "type": "text",
      "id": "twitter_url",
      "label": "X / Twitter URL",
      "default": "https://x.com/"
    },
    {
      "type": "text",
      "id": "pinterest_url",
      "label": "Pinterest URL",
      "default": "https://www.pinterest.com/"
    },
    {
