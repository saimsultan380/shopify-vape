{%- comment -%}
  ============================================================
  Vape Pro Single Product Page — sections/vape-product-page.liquid

  Matches the reference design:
  • Vertical thumbnail gallery + main image
  • Title, stars, sale price, inventory bar, flash sale
  • Dynamic variants, specs, qty, ATC, wishlist
  • Tabs: Description / Specs / Reviews / Custom
  • Feature highlights + full ratings section
  • Fully responsive
  ============================================================
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'vpp-product-form-' | append: section.id

  assign has_discount = false
  assign discount_percent = 0
  if current_variant.compare_at_price > current_variant.price
    assign has_discount = true
    assign discount_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif

  assign rating_value = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value
  assign rating_max = product.metafields.reviews.rating.value.scale_max | default: 5
  assign rating_count = product.metafields.reviews.rating_count | default: 0
  if rating_value == blank
    assign rating_value = section.settings.fallback_rating
    assign rating_count = section.settings.fallback_review_count
  endif
  assign rating_floor = rating_value | floor
  assign rating_decimal = rating_value | modulo: 1
  assign rating_half_at = rating_floor | plus: 1

  assign inventory_qty = current_variant.inventory_quantity | default: 0
  assign inventory_threshold = section.settings.inventory_threshold | default: 20
  assign show_inventory_bar = false
  if current_variant.inventory_management != blank and inventory_qty > 0 and inventory_qty <= inventory_threshold
    assign show_inventory_bar = true
  endif
  if section.settings.force_inventory_bar and inventory_qty > 0
    assign show_inventory_bar = true
  endif
  assign inventory_percent = inventory_qty | times: 100.0 | divided_by: inventory_threshold
  if inventory_percent > 100
    assign inventory_percent = 100
  endif

  assign flash_end = section.settings.flash_sale_end
  assign show_flash = section.settings.show_flash_sale
-%}

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% style %}
  #shopify-section-{{ section.id }} {
    --vpp-accent: {{ section.settings.accent_color }};
    --vpp-sale: {{ section.settings.sale_color }};
    --vpp-badge: {{ section.settings.badge_color }};
    --vpp-btn: {{ section.settings.button_bg }};
    --vpp-btn-text: {{ section.settings.button_text }};
    padding-block-start: {{ section.settings.padding_top }}px;
    padding-block-end: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.section_bg }};
  }
{% endstyle %}

<div
  id="vpp-{{ section.id }}"
  class="vpp"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-variant-id="{{ current_variant.id }}"
>
  {%- comment -%} ── Breadcrumb ── {%- endcomment -%}
  <nav class="vpp-breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span class="vpp-breadcrumb__sep">/</span>
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
      <span class="vpp-breadcrumb__sep">/</span>
    {%- elsif product.collections.first -%}
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title | escape }}</a>
      <span class="vpp-breadcrumb__sep">/</span>
    {%- endif -%}
    <span class="vpp-breadcrumb__current">{{ product.title | escape }}</span>
  </nav>

  {%- comment -%} ── Main grid: Gallery + Info ── {%- endcomment -%}
  <div class="vpp-main">
    {%- comment -%} LEFT: Media gallery {%- endcomment -%}
    <div class="vpp-gallery" data-vpp-gallery>
      {%- if product.media.size > 1 -%}
        <div class="vpp-thumbs" data-vpp-thumbs role="listbox" aria-label="Product images">
          {%- for media in product.media -%}
            <button
              type="button"
              class="vpp-thumb{% if forloop.first %} is-active{% endif %}"
              data-vpp-thumb
              data-index="{{ forloop.index0 }}"
              aria-label="View image {{ forloop.index }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              {{
                media.preview_image
                | image_url: width: 160
                | image_tag:
                  loading: 'lazy',
                  widths: '80, 120, 160',
                  sizes: '72px',
                  alt: media.alt | default: product.title | escape
              }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="vpp-main-media">
        {%- if product.featured_media -%}
          {%- for media in product.media -%}
            <div
              class="vpp-main-slide{% if forloop.first %} is-active{% endif %}"
              data-vpp-slide
              data-index="{{ forloop.index0 }}"
              {% unless forloop.first %}hidden{% endunless %}
            >
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- liquid
                    if forloop.first
                      assign img_loading = 'eager'
                    else
                      assign img_loading = 'lazy'
                    endif
                    assign img_alt = media.alt | default: product.title
                  -%}
                  {{
                    media
                    | image_url: width: 1400
                    | image_tag:
                      loading: img_loading,
                      widths: '400, 600, 800, 1000, 1200, 1400',
                      sizes: '(max-width: 749px) 100vw, 50vw',
                      alt: img_alt,
                      class: 'vpp-main-img'
                  }}
                {%- when 'video', 'external_video' -%}
                  {{ media | media_tag: image_size: '1100x', autoplay: false, loop: false, controls: true, class: 'vpp-main-video' }}
                {%- when 'model' -%}
                  {{ media | media_tag }}
                {%- else -%}
                  {{
                    media.preview_image
                    | image_url: width: 1400
                    | image_tag: loading: 'lazy', class: 'vpp-main-img', alt: product.title | escape
                  }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'vpp-placeholder' }}
        {%- endif -%}

        {%- if product.media.size > 1 -%}
          <button type="button" class="vpp-gallery-nav vpp-gallery-nav--prev" data-vpp-prev aria-label="Previous image">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button type="button" class="vpp-gallery-nav vpp-gallery-nav--next" data-vpp-next aria-label="Next image">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} RIGHT: Product info {%- endcomment -%}
    <div class="vpp-info">
      <h1 class="vpp-title">{{ product.title | escape }}</h1>

      <div class="vpp-rating-row">
        <div class="vpp-stars" aria-label="Rated {{ rating_value }} out of {{ rating_max }}">
          {%- for i in (1..rating_max) -%}
            {%- if i <= rating_floor -%}
              <span class="vpp-star is-filled">★</span>
            {%- elsif i == rating_half_at and rating_decimal >= 0.3 -%}
              <span class="vpp-star is-half">★</span>
            {%- else -%}
              <span class="vpp-star">★</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <a href="#vpp-reviews-{{ section.id }}" class="vpp-review-link">
          ({{ rating_count }}) write a review
        </a>
      </div>

      <div class="vpp-price-row" data-vpp-price>
        <span class="vpp-price" data-vpp-price-sale>{{ current_variant.price | money }}</span>
        <span
          class="vpp-compare{% unless has_discount %} is-hidden{% endunless %}"
          data-vpp-price-compare
        >
          {{- current_variant.compare_at_price | money -}}
        </span>
        <span
          class="vpp-discount-badge{% unless has_discount %} is-hidden{% endunless %}"
          data-vpp-discount
        >
          -{{ discount_percent }}%
        </span>
      </div>

      {%- if product.description != blank -%}
        <div class="vpp-excerpt">
          {{ product.description | strip_html | truncatewords: 45 }}
        </div>
      {%- endif -%}

      {%- if show_inventory_bar -%}
        <div class="vpp-stock" data-vpp-stock>
          <p class="vpp-stock__text">
            Hurry! Only <strong data-vpp-stock-qty>{{ inventory_qty }}</strong> left in stock
          </p>
          <div class="vpp-stock__bar" role="progressbar" aria-valuenow="{{ inventory_qty }}" aria-valuemin="0" aria-valuemax="{{ inventory_threshold }}">
            <span class="vpp-stock__fill" style="width: {{ inventory_percent }}%;" data-vpp-stock-fill></span>
          </div>
        </div>
      {%- endif -%}

      {%- if show_flash -%}
        {%- liquid
          assign flash_end_iso = blank
          if flash_end != blank
            assign flash_end_iso = flash_end | date: '%Y-%m-%dT%H:%M:%S'
          endif
        -%}
        <div class="vpp-flash" data-vpp-flash{% if flash_end_iso != blank %} data-end="{{ flash_end_iso }}"{% endif %}>
          <div class="vpp-flash__left">
            <span class="vpp-flash__label">{{ section.settings.flash_sale_label | escape }}</span>
            <div class="vpp-flash__timer" data-vpp-timer aria-live="polite">
              <span data-vpp-h>00</span>h :
              <span data-vpp-m>00</span>m :
              <span data-vpp-s>00</span>s
            </div>
          </div>
        </div>
      {%- endif -%}

      {%- form 'product', product, id: product_form_id, class: 'vpp-form', data-type: 'add-to-cart-form' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-vpp-variant-input>

        {%- unless product.has_only_default_variant -%}
          <div class="vpp-variants" data-vpp-variants>
            {%- for option in product.options_with_values -%}
              <fieldset class="vpp-option" data-option-index="{{ forloop.index0 }}">
                <legend class="vpp-option__label">{{ option.name | escape }}</legend>
                <div class="vpp-option__values">
                  {%- for value in option.values -%}
                    {%- assign option_disabled = true -%}
                    {%- if value.available -%}
                      {%- assign option_disabled = false -%}
                    {%- endif -%}
                    <label class="vpp-swatch{% if option.selected_value == value %} is-selected{% endif %}{% if option_disabled %} is-disabled{% endif %}">
                      <input
                        type="radio"
                        name="options[{{ option.name | escape }}]"
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}
                        {% if option_disabled %}disabled{% endif %}
                        data-vpp-option
                        data-option-position="{{ option.position }}"
                      >
                      <span>{{ value | escape }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        <ul class="vpp-specs" role="list">
          {%- if product.vendor != blank -%}
            <li><span>Brand</span><strong>{{ product.vendor | escape }}</strong></li>
          {%- endif -%}
          {%- if product.type != blank -%}
            <li><span>Type</span><strong>{{ product.type | escape }}</strong></li>
          {%- endif -%}
          <li>
            <span>SKU</span>
            <strong data-vpp-sku>{{ current_variant.sku | default: 'N/A' | escape }}</strong>
          </li>
          <li>
            <span>Availability</span>
            <strong class="vpp-availability{% if current_variant.available %} is-in{% else %} is-out{% endif %}" data-vpp-availability>
              {%- if current_variant.available -%}
                In stock, ready to ship
              {%- else -%}
                Out of stock
              {%- endif -%}
            </strong>
          </li>
          {%- if product.metafields.custom.specifications != blank -%}
            <li><span>Specs</span><strong>{{ product.metafields.custom.specifications.value | default: product.metafields.custom.specifications | escape }}</strong></li>
          {%- endif -%}
        </ul>

        <div class="vpp-actions">
          <div class="vpp-qty" data-vpp-qty>
            <button type="button" class="vpp-qty__btn" data-vpp-qty-minus aria-label="Decrease quantity">−</button>
            <input
              type="number"
              name="quantity"
              value="1"
              min="1"
              class="vpp-qty__input"
              data-vpp-qty-input
              aria-label="Quantity"
            >
            <button type="button" class="vpp-qty__btn" data-vpp-qty-plus aria-label="Increase quantity">+</button>
          </div>

          <button
            type="submit"
            name="add"
            class="vpp-atc"
            data-vpp-atc
            {% unless current_variant.available %}disabled{% endunless %}
          >
            <span data-vpp-atc-text>
              {%- if current_variant.available -%}
                ADD TO CART
              {%- else -%}
                SOLD OUT
              {%- endif -%}
            </span>
          </button>

          <a
            href="{{ section.settings.wishlist_url | default: '/pages/wishlist' }}"
            class="vpp-wishlist"
            aria-label="Add to wishlist"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </a>
        </div>
      {%- endform -%}

      <div class="vpp-utils">
        <button type="button" class="vpp-util" data-vpp-share data-url="{{ shop.url }}{{ product.url }}" data-title="{{ product.title | escape }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
          Share
        </button>
        <a href="#vpp-tabs-{{ section.id }}" class="vpp-util" data-vpp-ask>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          Ask a question
        </a>
      </div>

      {%- if section.settings.show_payment_icons -%}
        <div class="vpp-payments">
          <p class="vpp-payments__label">{{ section.settings.payment_label | escape }}</p>
          <ul class="vpp-payments__list" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ── Tabs ── {%- endcomment -%}
  <div class="vpp-tabs" id="vpp-tabs-{{ section.id }}" data-vpp-tabs>
    <div class="vpp-tabs__nav" role="tablist">
      <button type="button" class="vpp-tab is-active" role="tab" aria-selected="true" data-tab="description">Description</button>
      <button type="button" class="vpp-tab" role="tab" aria-selected="false" data-tab="specifications">Specifications</button>
      <button type="button" class="vpp-tab" role="tab" aria-selected="false" data-tab="reviews">Reviews and Ratings</button>
      <button type="button" class="vpp-tab" role="tab" aria-selected="false" data-tab="custom">{{ section.settings.custom_tab_label | default: 'Contact Us' | escape }}</button>
    </div>

    <div class="vpp-tabs__panels">
      <div class="vpp-panel is-active" data-panel="description" role="tabpanel">
        <div class="vpp-rte">
          {%- if product.description != blank -%}
            {{ product.description }}
          {%- else -%}
            <p>No description available for this product.</p>
          {%- endif -%}
        </div>
      </div>

      <div class="vpp-panel" data-panel="specifications" role="tabpanel" hidden>
        <div class="vpp-rte">
          {%- if product.metafields.custom.specifications != blank -%}
            {{ product.metafields.custom.specifications | metafield_tag }}
          {%- else -%}
            <ul class="vpp-spec-list">
              {%- if product.vendor != blank -%}<li><strong>Brand:</strong> {{ product.vendor | escape }}</li>{%- endif -%}
              {%- if product.type != blank -%}<li><strong>Type:</strong> {{ product.type | escape }}</li>{%- endif -%}
              {%- if current_variant.sku != blank -%}<li><strong>SKU:</strong> {{ current_variant.sku | escape }}</li>{%- endif -%}
              {%- if product.tags.size > 0 -%}
                <li><strong>Tags:</strong> {{ product.tags | join: ', ' | escape }}</li>
              {%- endif -%}
              {%- for option in product.options_with_values -%}
                <li><strong>{{ option.name | escape }}:</strong> {{ option.values | join: ', ' | escape }}</li>
              {%- endfor -%}
              <li><strong>Weight:</strong> {{ current_variant.weight | weight_with_unit: current_variant.weight_unit }}</li>
            </ul>
          {%- endif -%}
        </div>
      </div>

      <div class="vpp-panel" data-panel="reviews" role="tabpanel" hidden>
        <div id="shopify-product-reviews" data-id="{{ product.id }}">{{ product.metafields.spr.reviews }}</div>
        <p class="vpp-reviews-fallback">
          <a href="#vpp-reviews-{{ section.id }}">See full ratings & reviews below</a>
        </p>
      </div>

      <div class="vpp-panel" data-panel="custom" role="tabpanel" hidden>
        <div class="vpp-rte">
          {%- if section.settings.custom_tab_content != blank -%}
            {{ section.settings.custom_tab_content }}
          {%- else -%}
            <p>Have a question about this product? Contact us at <a href="mailto:{{ shop.email }}">{{ shop.email }}</a>.</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ── Feature highlights ── {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <div class="vpp-features">
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature' -%}
          <div class="vpp-feature" {{ block.shopify_attributes }}>
            <div class="vpp-feature__icon" aria-hidden="true">{{ block.settings.icon_text | escape }}</div>
            <div class="vpp-feature__body">
              <h3 class="vpp-feature__title">{{ block.settings.title | escape }}</h3>
              <p class="vpp-feature__text">{{ block.settings.text | escape }}</p>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} ── Full Ratings Section ── {%- endcomment -%}
  <div class="vpp-reviews" id="vpp-reviews-{{ section.id }}">
    <div class="vpp-reviews__header">
      <h2 class="vpp-reviews__heading">{{ section.settings.reviews_heading | escape }}</h2>
      <p class="vpp-reviews__sub">Based on {{ rating_count }} customer review{% if rating_count != 1 %}s{% endif %}</p>
    </div>

    <div class="vpp-reviews__grid">
      <div class="vpp-reviews__summary">
        <div class="vpp-reviews__score">{{ rating_value | round: 1 }}</div>
        <div class="vpp-stars vpp-stars--lg" aria-hidden="true">
          {%- for i in (1..5) -%}
            <span class="vpp-star{% if i <= rating_floor %} is-filled{% endif %}">★</span>
          {%- endfor -%}
        </div>
        <p class="vpp-reviews__count">{{ rating_count }} reviews</p>
      </div>

      <div class="vpp-reviews__bars">
        {%- assign dist_5 = section.settings.dist_5 -%}
        {%- assign dist_4 = section.settings.dist_4 -%}
        {%- assign dist_3 = section.settings.dist_3 -%}
        {%- assign dist_2 = section.settings.dist_2 -%}
        {%- assign dist_1 = section.settings.dist_1 -%}
        {%- for star_n in (5..1) -%}
          {%- liquid
            case star_n
              when 5
                assign bar_pct = dist_5
              when 4
                assign bar_pct = dist_4
              when 3
                assign bar_pct = dist_3
              when 2
                assign bar_pct = dist_2
              else
                assign bar_pct = dist_1
            endcase
          -%}
          <div class="vpp-bar-row">
            <span class="vpp-bar-label">{{ star_n }} star</span>
            <div class="vpp-bar-track"><span class="vpp-bar-fill" style="width: {{ bar_pct }}%;"></span></div>
            <span class="vpp-bar-pct">{{ bar_pct }}%</span>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- assign review_blocks = section.blocks | where: 'type', 'review' -%}
    {%- if review_blocks.size > 0 -%}
      <div class="vpp-review-list">
        {%- for block in review_blocks -%}
          <article class="vpp-review-card" {{ block.shopify_attributes }}>
            <div class="vpp-review-card__top">
              <div class="vpp-stars" aria-label="{{ block.settings.rating }} out of 5">
                {%- assign r = block.settings.rating | default: 5 -%}
                {%- for i in (1..5) -%}
                  <span class="vpp-star{% if i <= r %} is-filled{% endif %}">★</span>
                {%- endfor -%}
              </div>
              {%- if block.settings.date != blank -%}
                <time class="vpp-review-card__date">{{ block.settings.date | escape }}</time>
              {%- endif -%}
            </div>
            {%- if block.settings.title != blank -%}
              <h3 class="vpp-review-card__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            <p class="vpp-review-card__body">{{ block.settings.body | escape }}</p>
            <p class="vpp-review-card__author">— {{ block.settings.author | escape }}</p>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- comment -%} Variant JSON for JS picker {%- endcomment -%}
<script type="application/json" data-vpp-variants-json>
  {{ product.variants | json }}
</script>

<style>
  /* ============================================================
     VAPE PRO PRODUCT PAGE (vpp)
  ============================================================ */
  .vpp {
    width: 100%;
    max-width: var(--page-width, 1400px);
    margin-inline: auto;
    padding-inline: var(--vape-page-padding, clamp(1rem, 4vw, 3.5rem));
    font-family: var(--vape-font-primary, 'Inter', system-ui, sans-serif);
    color: #222;
  }

  .vpp-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: #888;
    margin-bottom: 1.75rem;
  }
  .vpp-breadcrumb a { color: #666; text-decoration: none; }
  .vpp-breadcrumb a:hover { color: var(--vpp-accent, #e53935); }
  .vpp-breadcrumb__current { color: #222; }
  .vpp-breadcrumb__sep { opacity: 0.45; }

  /* ── Main two-column layout ── */
  .vpp-main {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 990px) {
    .vpp-main {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 3.5rem;
