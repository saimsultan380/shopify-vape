</style>

<script>
(function () {
  const root = document.getElementById('vcp-{{ section.id }}');
  if (!root) return;

  const sidebar = root.querySelector('[data-vcp-sidebar]');
  const overlay = root.querySelector('[data-vcp-overlay]');
  const grid = root.querySelector('[data-vcp-grid]');
  const filterForm = root.querySelector('[data-vcp-filter-form]');

  /* Mobile filters */
  function openFilters() {
    sidebar?.classList.add('is-open');
    if (overlay) overlay.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function closeFilters() {
    sidebar?.classList.remove('is-open');
    if (overlay) overlay.hidden = true;
    document.body.style.overflow = '';
  }
  root.querySelector('[data-vcp-open-filters]')?.addEventListener('click', openFilters);
  root.querySelector('[data-vcp-close-filters]')?.addEventListener('click', closeFilters);
  overlay?.addEventListener('click', closeFilters);

  /* See more categories */
  root.querySelector('[data-vcp-see-more]')?.addEventListener('click', (e) => {
    const btn = e.currentTarget;
    const extras = root.querySelectorAll('.vcp-cats .is-extra');
    const expanding = btn.textContent.indexOf('+') !== -1;
    extras.forEach((el) => { el.hidden = !expanding; });
    btn.textContent = expanding ? 'See Less −' : 'See More +';
  });

  /* View toggles */
  const viewBtns = root.querySelectorAll('[data-vcp-view]');
  const savedView = localStorage.getItem('vcp-view') || '3';
  function setView(view) {
    viewBtns.forEach((btn) => {
      const on = btn.dataset.vcpView === view;
      btn.classList.toggle('is-active', on);
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    if (!grid) return;
    grid.classList.remove('vcp-grid--cols-3', 'vcp-grid--cols-2', 'vcp-grid--list');
    if (view === 'list') grid.classList.add('vcp-grid--list');
    else if (view === '2') grid.classList.add('vcp-grid--cols-2');
    else grid.classList.add('vcp-grid--cols-3');
    localStorage.setItem('vcp-view', view);
  }
  setView(savedView);
  viewBtns.forEach((btn) => btn.addEventListener('click', () => setView(btn.dataset.vcpView)));

  /* Sort */
  root.querySelector('[data-vcp-sort]')?.addEventListener('change', (e) => {
    const url = new URL(window.location.href);
    url.searchParams.set('sort_by', e.target.value);
    window.location.href = url.toString();
  });

  /* Filter form submit on change */
  let filterTimer;
  function submitFilters() {
    if (!filterForm) return;
    const data = new FormData(filterForm);
    const url = new URL(window.location.href);
    /* Clear existing filter params, keep sort */
    const sort = url.searchParams.get('sort_by');
    [...url.searchParams.keys()].forEach((k) => {
      if (k.startsWith('filter.') || k === 'page') url.searchParams.delete(k);
    });
    for (const [key, value] of data.entries()) {
      if (value === '' || value == null) continue;
      url.searchParams.append(key, value);
    }
    if (sort) url.searchParams.set('sort_by', sort);
    window.location.href = url.toString();
  }

  filterForm?.querySelectorAll('input[type="checkbox"]').forEach((input) => {
    input.addEventListener('change', () => {
      clearTimeout(filterTimer);
      filterTimer = setTimeout(submitFilters, 150);
    });
  });

  /* Price dual range */
  const price = root.querySelector('[data-vcp-price]');
  if (price) {
    const minRange = price.querySelector('[data-vcp-price-min]');
    const maxRange = price.querySelector('[data-vcp-price-max]');
    const minInput = price.querySelector('[data-vcp-price-min-input]');
    const maxInput = price.querySelector('[data-vcp-price-max-input]');
    const track = price.querySelector('[data-vcp-price-track]');
    const absoluteMax = parseFloat(price.dataset.max) || 100;

    function syncTrack() {
      const min = parseFloat(minRange.value);
      const max = parseFloat(maxRange.value);
      const left = (min / absoluteMax) * 100;
      const right = 100 - (max / absoluteMax) * 100;
      track.style.setProperty('--vcp-price-left', left + '%');
      track.style.setProperty('--vcp-price-right', right + '%');
    }

    function clampRanges(from) {
      let min = parseFloat(minRange.value);
      let max = parseFloat(maxRange.value);
      if (min > max) {
        if (from === 'min') minRange.value = max;
        else maxRange.value = min;
      }
      minInput.value = minRange.value;
      maxInput.value = maxRange.value;
      syncTrack();
    }

    minRange.addEventListener('input', () => clampRanges('min'));
    maxRange.addEventListener('input', () => clampRanges('max'));
    minRange.addEventListener('change', () => { clearTimeout(filterTimer); filterTimer = setTimeout(submitFilters, 250); });
    maxRange.addEventListener('change', () => { clearTimeout(filterTimer); filterTimer = setTimeout(submitFilters, 250); });

    minInput.addEventListener('change', () => {
      minRange.value = minInput.value;
      clampRanges('min');
      submitFilters();
    });
    maxInput.addEventListener('change', () => {
      maxRange.value = maxInput.value;
      clampRanges('max');
      submitFilters();
    });
    syncTrack();
  }

  /* Load more */
  const loadBtn = root.querySelector('[data-vcp-load-btn]');
  const showingEl = root.querySelector('[data-vcp-showing]');
  const progressEl = root.querySelector('[data-vcp-progress]');
  const totalProducts = {{ total_products | json }};

  loadBtn?.addEventListener('click', async () => {
    const next = loadBtn.dataset.next;
    if (!next) return;
    loadBtn.disabled = true;
    loadBtn.textContent = 'LOADING…';

    try {
      const res = await fetch(next);
      const html = await res.text();
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const remoteGrid = doc.querySelector('[data-vcp-grid]');
      const remoteBtn = doc.querySelector('[data-vcp-load-btn]');
      const remoteShowing = doc.querySelector('[data-vcp-showing]');
      const remoteProgress = doc.querySelector('[data-vcp-progress]');

      if (remoteGrid) {
        Array.from(remoteGrid.children).forEach((card) => grid.appendChild(card));
      }

      if (remoteShowing && showingEl) showingEl.textContent = remoteShowing.textContent;
      if (remoteProgress && progressEl) {
        progressEl.style.width = remoteProgress.style.width;
      }

      if (remoteBtn && remoteBtn.dataset.next) {
        loadBtn.dataset.next = remoteBtn.dataset.next;
        loadBtn.disabled = false;
        loadBtn.textContent = 'LOAD MORE ITEMS';
      } else {
        loadBtn.remove();
      }

      /* rebind quick add on new cards */
      grid.querySelectorAll('[data-quick-add-btn]').forEach((btn) => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const id = btn.dataset.variantId;
          if (!id) return;
          fetch((window.Shopify?.routes?.root || '/') + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: [{ id: parseInt(id, 10), quantity: 1 }] })
          }).then((r) => r.json()).then(() => {
            document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          });
        });
      });
    } catch (err) {
      loadBtn.disabled = false;
      loadBtn.textContent = 'LOAD MORE ITEMS';
    }
  });

  /* Initial quick-add bind */
  root.querySelectorAll('[data-quick-add-btn]').forEach((btn) => {
    btn.dataset.bound = '1';
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const id = btn.dataset.variantId;
      if (!id) return;
      fetch((window.Shopify?.routes?.root || '/') + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: parseInt(id, 10), quantity: 1 }] })
      }).then((r) => r.json()).then(() => {
        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
      });
    });
  });
})();
</script>

