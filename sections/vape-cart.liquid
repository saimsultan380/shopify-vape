{%- comment -%}
  ============================================================
  Vape Cart Page — sections/vape-cart.liquid

  Matches reference:
  • Banner + breadcrumb
  • Cart table: remove, image, title, price, qty, line total
  • Order summary + free shipping progress
  • Proceed to checkout / Continue shopping
  • You may also like recommendations
  ============================================================
{%- endcomment -%}

{%- liquid
  assign free_ship_threshold = section.settings.free_shipping_threshold | times: 100
  assign cart_total = cart.total_price
  assign remaining = free_ship_threshold | minus: cart_total
  if remaining < 0
    assign remaining = 0
  endif
  assign progress_pct = 0
  if free_ship_threshold > 0
    assign progress_pct = cart_total | times: 100.0 | divided_by: free_ship_threshold
    if progress_pct > 100
      assign progress_pct = 100
    endif
  endif
  assign rec_collection = section.settings.recommendation_collection
  assign rec_limit = section.settings.recommendation_count | default: 4
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --vc-banner: {{ section.settings.banner_bg }};
    --vc-green: {{ section.settings.shipping_accent }};
    --vc-summary-bg: {{ section.settings.summary_bg }};
  }
{% endstyle %}

<section
  id="vc-{{ section.id }}"
  class="vc"
  data-section-id="{{ section.id }}"
  data-free-shipping="{{ free_ship_threshold }}"
  data-money-format="{{ shop.money_format | escape }}"
>
  {%- comment -%} Banner {%- endcomment -%}
  <div class="vc-banner">
    <div class="vc-banner__inner">
      <h1 class="vc-banner__title">{{ section.settings.heading | default: 'Your Shopping Cart' | upcase | escape }}</h1>
      <nav class="vc-banner__crumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">•</span>
        <span>Your Shopping Cart</span>
      </nav>
    </div>
  </div>

  <div class="vc-shell" data-vc-root>
    {%- if cart.empty? -%}
      <div class="vc-empty" data-vc-empty>
        <p class="vc-empty__text">{{ section.settings.empty_message | escape }}</p>
        <a href="{{ section.settings.continue_url | default: routes.all_products_collection_url }}" class="vc-btn vc-btn--solid">
          CONTINUE SHOPPING
        </a>
      </div>
    {%- else -%}
      <div class="vc-layout" data-vc-filled>
        {%- comment -%} LEFT: cart table {%- endcomment -%}
        <div class="vc-table-wrap">
          <div class="vc-thead" aria-hidden="true">
            <span class="vc-col vc-col--product">Product</span>
            <span class="vc-col vc-col--price">Price</span>
            <span class="vc-col vc-col--qty">Qty</span>
            <span class="vc-col vc-col--total">Total</span>
          </div>

          <ul class="vc-items" role="list" data-vc-items>
            {%- for item in cart.items -%}
              <li
                class="vc-item"
                data-vc-item
                data-key="{{ item.key }}"
                data-line="{{ forloop.index }}"
                data-price="{{ item.final_price }}"
              >
                <button
                  type="button"
                  class="vc-item__remove"
                  data-vc-remove
                  aria-label="Remove {{ item.product.title | escape }}"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                    <path d="M10 11v6M14 11v6"></path>
                    <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
                  </svg>
                </button>

                <div class="vc-item__product">
                  <a href="{{ item.url }}" class="vc-item__img">
                    {%- if item.image -%}
                      {{
                        item.image
                        | image_url: width: 200
                        | image_tag:
                          loading: 'lazy',
                          widths: '80, 120, 160, 200',
                          sizes: '80px',
                          alt: item.product.title | escape
                      }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'vc-item__placeholder' }}
                    {%- endif -%}
                  </a>
                  <div class="vc-item__meta">
                    <a href="{{ item.url }}" class="vc-item__title">{{ item.product.title | escape }}</a>
                    {%- unless item.product.has_only_default_variant -%}
                      <p class="vc-item__variant">{{ item.variant.title | escape }}</p>
                    {%- endunless -%}
                    {%- if item.selling_plan_allocation -%}
                      <p class="vc-item__variant">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
                    {%- endif -%}
                    {%- for property in item.properties -%}
                      {%- assign first_char = property.first | slice: 0 -%}
                      {%- if property.last != blank and first_char != '_' -%}
                        <p class="vc-item__variant">{{ property.first | escape }}: {{ property.last | escape }}</p>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>

                <div class="vc-item__price" data-label="Price">
                  <span data-vc-unit-price>{{ item.final_price | money }}</span>
                  {%- if item.original_price > item.final_price -%}
                    <s class="vc-item__compare">{{ item.original_price | money }}</s>
                  {%- endif -%}
                </div>

                <div class="vc-item__qty" data-label="Qty">
                  <div class="vc-qty" data-vc-qty>
                    <button type="button" class="vc-qty__btn" data-vc-qty-minus aria-label="Decrease quantity">−</button>
                    <input
                      class="vc-qty__input"
                      type="number"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      data-vc-qty-input
                      aria-label="Quantity for {{ item.product.title | escape }}"
                    >
                    <button type="button" class="vc-qty__btn" data-vc-qty-plus aria-label="Increase quantity">+</button>
                  </div>
                </div>

                <div class="vc-item__total" data-label="Total">
                  <strong data-vc-line-total>{{ item.final_line_price | money }}</strong>
                </div>
              </li>
            {%- endfor -%}
          </ul>

          <div class="vc-actions">
            <form action="{{ routes.cart_url }}" method="post" class="vc-checkout-form">
              <button type="submit" name="checkout" class="vc-btn vc-btn--outline" data-vc-checkout>
                PROCEED TO CHECKOUT
              </button>
            </form>
            <a
              href="{{ section.settings.continue_url | default: routes.all_products_collection_url }}"
              class="vc-btn vc-btn--solid"
            >
              CONTINUE SHOPPING
            </a>
          </div>
        </div>

        {%- comment -%} RIGHT: summary {%- endcomment -%}
        <aside class="vc-summary">
          <p class="vc-summary__count" data-vc-count-text>
            {%- if cart.item_count == 1 -%}
              THERE IS <span data-vc-count>1</span> ITEM IN YOUR CART
            {%- else -%}
              THERE ARE <span data-vc-count>{{ cart.item_count }}</span> ITEMS IN YOUR CART
            {%- endif -%}
          </p>

          <div class="vc-summary__row vc-summary__row--total">
            <span>TOTAL:</span>
            <strong data-vc-cart-total>{{ cart.total_price | money }}</strong>
          </div>

          <div class="vc-summary__row vc-summary__row--shipping">
            <span>SHIPPING:</span>
            <em>{{ section.settings.shipping_note | escape }}</em>
          </div>

          {%- if section.settings.show_free_shipping -%}
            <div class="vc-shipping" data-vc-shipping {% if remaining == 0 %}data-qualified="true"{% endif %}>
              <p class="vc-shipping__spend" data-vc-spend-text>
                {%- if remaining == 0 -%}
                  YOU'VE UNLOCKED FREE SHIPPING
                {%- else -%}
                  SPEND <span data-vc-remaining>{{ remaining | money }}</span> FOR FREE SHIPPING
                {%- endif -%}
              </p>
              <div class="vc-shipping__bar" role="progressbar" aria-valuenow="{{ progress_pct | round }}" aria-valuemin="0" aria-valuemax="100">
                <span class="vc-shipping__fill" style="width: {{ progress_pct }}%;" data-vc-progress>
                  <span class="vc-shipping__truck" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  </span>
                </span>
              </div>
              <p class="vc-shipping__note">
                Free shipping for any orders above {{ free_ship_threshold | money }}
              </p>
            </div>
          {%- endif -%}

          {%- if section.settings.show_cart_note -%}
            <div class="vc-note">
              <label for="vc-note-{{ section.id }}">Order note</label>
              <textarea
                id="vc-note-{{ section.id }}"
                data-vc-note
                rows="3"
                placeholder="{{ section.settings.note_placeholder | escape }}"
              >{{ cart.note }}</textarea>
            </div>
          {%- endif -%}

          <form action="{{ routes.cart_url }}" method="post">
            <button type="submit" name="checkout" class="vc-btn vc-btn--solid vc-btn--full" data-vc-checkout>
              PROCEED TO CHECKOUT
            </button>
          </form>
        </aside>
      </div>
    {%- endif -%}

    {%- comment -%} Recommendations {%- endcomment -%}
    {%- if section.settings.show_recommendations -%}
      <div class="vc-recs">
        <h2 class="vc-recs__title">{{ section.settings.recs_heading | escape }}</h2>
        <div class="vc-recs__grid">
          {%- if rec_collection != blank -%}
            {%- for product in rec_collection.products limit: rec_limit -%}
              <a href="{{ product.url }}" class="vc-rec">
                <div class="vc-rec__img">
                  {%- if product.featured_media -%}
                    {{
                      product.featured_media
                      | image_url: width: 400
                      | image_tag:
                        loading: 'lazy',
                        widths: '200, 300, 400',
                        sizes: '(max-width: 749px) 45vw, 22vw',
                        alt: product.title | escape
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>
                <h3 class="vc-rec__name">{{ product.title | escape }}</h3>
                <p class="vc-rec__price">{{ product.price | money }}</p>
              </a>
            {%- endfor -%}
          {%- else -%}
            {%- for product in collections.all.products limit: rec_limit -%}
              <a href="{{ product.url }}" class="vc-rec">
                <div class="vc-rec__img">
                  {%- if product.featured_media -%}
                    {{
                      product.featured_media
                      | image_url: width: 400
                      | image_tag: loading: 'lazy', alt: product.title | escape
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>
                <h3 class="vc-rec__name">{{ product.title | escape }}</h3>
                <p class="vc-rec__price">{{ product.price | money }}</p>
              </a>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .vc {
    font-family: var(--vape-font-primary, 'Inter', system-ui, sans-serif);
    color: #222;
    background: #fff;
  }

  .vc-banner {
    background: var(--vc-banner, #f5f5f5);
    padding: 2.75rem 0;
  }
  .vc-banner__inner {
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
    padding-inline: var(--vape-page-padding, clamp(1rem, 4vw, 3.5rem));
  }
  .vc-banner__title {
    margin: 0 0 0.5rem;
    font-size: clamp(1.6rem, 3.5vw, 2.25rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #111;
    line-height: 1.15;
  }
  .vc-banner__crumb {
    display: flex;
    gap: 0.45rem;
    align-items: center;
    font-size: 0.875rem;
    color: #777;
  }
  .vc-banner__crumb a {
    color: #777;
    text-decoration: none;
  }
  .vc-banner__crumb a:hover { color: var(--vape-accent, #e53935); }

  .vc-shell {
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
    padding: 2.5rem var(--vape-page-padding, clamp(1rem, 4vw, 3.5rem)) 3rem;
  }

  .vc-empty {
    text-align: center;
    padding: 4rem 1rem;
  }
  .vc-empty__text {
    font-size: 1.05rem;
    color: #555;
    margin: 0 0 1.5rem;
  }

  .vc-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 990px) {
    .vc-layout {
      grid-template-columns: minmax(0, 1.7fr) minmax(280px, 0.85fr);
      gap: 2.5rem;
    }
  }

  /* Table */
  .vc-thead {
    display: none;
    background: #f0f0f0;
    padding: 0.85rem 1rem;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #111;
  }
  @media (min-width: 750px) {
    .vc-thead {
      display: grid;
      grid-template-columns: minmax(0, 1.8fr) 0.7fr 0.9fr 0.7fr;
      gap: 0.75rem;
      padding-left: 3rem;
    }
  }

  .vc-items {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .vc-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid #eee;
    align-items: center;
    position: relative;
  }
  @media (min-width: 750px) {
    .vc-item {
      grid-template-columns: auto minmax(0, 1.8fr) 0.7fr 0.9fr 0.7fr;
      gap: 0.75rem;
      padding: 1.35rem 0;
    }
  }

  .vc-item.is-updating { opacity: 0.55; pointer-events: none; }

  .vc-item__remove {
    width: 32px;
    height: 32px;
    border: 0;
    background: transparent;
    color: #888;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: color 0.2s ease;
  }
  .vc-item__remove:hover { color: #e53935; }

  .vc-item__product {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }
  .vc-item__img {
    flex: 0 0 72px;
    width: 72px;
    height: 72px;
    background: #f7f7f7;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .vc-item__img img,
  .vc-item__placeholder {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .vc-item__title {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
    color: #111;
    text-decoration: none;
    line-height: 1.35;
  }
  .vc-item__title:hover { color: var(--vape-accent, #e53935); }
  .vc-item__variant {
    margin: 0.25rem 0 0;
    font-size: 0.8rem;
    color: #888;
  }

  .vc-item__price,
  .vc-item__qty,
  .vc-item__total {
    font-size: 0.95rem;
    color: #222;
  }
  .vc-item__compare {
    display: block;
    color: #999;
    font-size: 0.8rem;
  }
  .vc-item__total strong {
    font-size: 1rem;
    font-weight: 800;
    color: #111;
  }

  @media (max-width: 749px) {
    .vc-item__price,
    .vc-item__qty,
    .vc-item__total {
      grid-column: 2;
    }
    .vc-item__price::before,
    .vc-item__qty::before,
    .vc-item__total::before {
      content: attr(data-label) ': ';
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      color: #999;
      margin-right: 0.35rem;
    }
    .vc-item__qty { display: flex; align-items: center; }
  }

  .vc-qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid #ddd;
    background: #fff;
    height: 40px;
  }
  .vc-qty__btn {
    width: 36px;
    height: 100%;
    border: 0;
    background: transparent;
    font-size: 1.1rem;
    cursor: pointer;
    color: #333;
  }
  .vc-qty__btn:hover { background: #f5f5f5; }
  .vc-qty__input {
    width: 42px;
    height: 100%;
    border: 0 !important;
    border-left: 1px solid #eee !important;
    border-right: 1px solid #eee !important;
    text-align: center;
    font-weight: 700;
    background: #fff !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    -moz-appearance: textfield;
    padding: 0 !important;
  }
  .vc-qty__input::-webkit-outer-spin-button,
  .vc-qty__input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  .vc-actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  @media (min-width: 600px) {
    .vc-actions { grid-template-columns: 1fr 1fr; }
  }
  .vc-checkout-form { display: contents; }
  .vc-actions .vc-btn,
  .vc-summary .vc-btn {
    width: 100%;
  }

  .vc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0.85rem 1.25rem;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 0;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    font-family: inherit;
  }
  .vc-btn--outline {
    background: #fff;
    color: #111;
    border: 1px solid #111;
  }
  .vc-btn--outline:hover {
    background: #111;
    color: #fff;
  }
  .vc-btn--solid {
    background: #111;
    color: #fff;
    border: 1px solid #111;
  }
  .vc-btn--solid:hover {
    background: #333;
    border-color: #333;
  }
  .vc-btn--full {
    width: 100%;
    margin-top: 1.25rem;
  }

  /* Summary */
  .vc-summary {
    background: var(--vc-summary-bg, #f7f7f7);
    border: 1px solid #ececec;
    padding: 1.5rem 1.35rem 1.6rem;
  }
  @media (min-width: 990px) {
    .vc-summary {
      position: sticky;
      top: 6rem;
    }
  }

  .vc-summary__count {
    margin: 0 0 1.25rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #333;
  }

  .vc-summary__row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding: 0.65rem 0;
  }
  .vc-summary__row--total {
    border-top: 1px solid #e5e5e5;
    border-bottom: 1px solid #e5e5e5;
    padding: 1rem 0;
    font-weight: 700;
  }
  .vc-summary__row--total strong {
    font-size: 1.35rem;
    font-weight: 900;
    color: #111;
  }
  .vc-summary__row--shipping span {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .vc-summary__row--shipping em {
    font-style: normal;
    font-size: 0.8rem;
    color: #888;
    text-align: right;
    max-width: 60%;
    line-height: 1.4;
  }

  .vc-shipping {
    margin-top: 1.25rem;
  }
  .vc-shipping__spend {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--vc-green, #39b54a);
  }
  .vc-shipping__bar {
    position: relative;
    height: 8px;
    background: #e5e5e5;
    border-radius: 99px;
    overflow: visible;
    margin-bottom: 0.65rem;
  }
  .vc-shipping__fill {
    position: relative;
    display: block;
    height: 100%;
    background: var(--vc-green, #39b54a);
    border-radius: 99px;
    min-width: 0;
    transition: width 0.4s ease;
  }
  .vc-shipping__truck {
    position: absolute;
    right: -12px;
    top: 50%;
    transform: translateY(-50%);
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid var(--vc-green, #39b54a);
    color: var(--vc-green, #39b54a);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(0,0,0,0.08);
  }
  .vc-shipping__note {
    margin: 0;
    font-size: 0.8rem;
    color: var(--vc-green, #39b54a);
    line-height: 1.4;
  }
  .vc-shipping[data-qualified="true"] .vc-shipping__spend {
    color: var(--vc-green, #39b54a);
  }

  .vc-note {
    margin-top: 1.25rem;
  }
  .vc-note label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.4rem;
    color: #555;
  }
  .vc-note textarea {
    width: 100%;
    border: 1px solid #ddd !important;
    background: #fff !important;
    border-radius: 0 !important;
    padding: 0.65rem 0.75rem !important;
    font-size: 0.875rem !important;
    resize: vertical;
    min-height: 70px;
    box-shadow: none !important;
  }

  /* Recommendations */
  .vc-recs {
    margin-top: 4rem;
    padding-top: 0.5rem;
  }
  .vc-recs__title {
    margin: 0 0 1.75rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: #111;
  }
  .vc-recs__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  @media (min-width: 750px) {
    .vc-recs__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; }
  }

  .vc-rec {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid #eee;
    padding: 1rem;
    background: #fff;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .vc-rec:hover {
    border-color: #ddd;
    box-shadow: 0 8px 20px rgba(0,0,0,0.05);
  }
  .vc-rec__img {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.85rem;
    overflow: hidden;
  }
  .vc-rec__img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .vc-rec__name {
    margin: 0 0 0.35rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: #111;
    line-height: 1.35;
  }
  .vc-rec__price {
    margin: 0;
    font-size: 0.9rem;
    color: #333;
  }
</style>

<script>
(function () {
  const root = document.getElementById('vc-{{ section.id }}');
  if (!root) return;

  const freeShipThreshold = parseInt(root.dataset.freeShipping || '0', 10);
  const moneyFormat = root.dataset.moneyFormat || '${{amount}}';
  const cartChangeUrl = (window.Theme?.routes?.cart_change_url || '/cart/change') + '.js';
  const cartUpdateUrl = (window.Theme?.routes?.cart_update_url || '/cart/update') + '.js';
  const cartUrl = (window.Theme?.routes?.cart_url || '/cart') + '.js';

  function formatMoney(cents) {
    const amount = (Number(cents) / 100).toFixed(2);
    if (typeof Shopify !== 'undefined' && Shopify.formatMoney) {
      return Shopify.formatMoney(cents, moneyFormat);
    }
    return moneyFormat
      .replace(/\{\{\s*amount\s*\}\}/, amount)
      .replace(/\{\{\s*amount_no_decimals\s*\}\}/, String(Math.round(cents / 100)))
      .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/, amount.replace('.', ','))
      .replace(/\{\{\s*amount_with_apostrophe_separator\s*\}\}/, amount);
  }

  function updateShippingUI(totalPrice) {
    const box = root.querySelector('[data-vc-shipping]');
    if (!box || !freeShipThreshold) return;
    const remaining = Math.max(0, freeShipThreshold - totalPrice);
    const pct = Math.min(100, (totalPrice / freeShipThreshold) * 100);
    const spend = box.querySelector('[data-vc-spend-text]');
    const remEl = box.querySelector('[data-vc-remaining]');
    const fill = box.querySelector('[data-vc-progress]');
    const bar = box.querySelector('.vc-shipping__bar');

    if (remaining === 0) {
      box.dataset.qualified = 'true';
      if (spend) spend.textContent = "YOU'VE UNLOCKED FREE SHIPPING";
    } else {
      box.dataset.qualified = 'false';
      if (spend) {
        spend.innerHTML = 'SPEND <span data-vc-remaining>' + formatMoney(remaining) + '</span> FOR FREE SHIPPING';
      }
    }
    if (fill) fill.style.width = pct + '%';
    if (bar) bar.setAttribute('aria-valuenow', String(Math.round(pct)));
  }

  function updateSummary(cart) {
    const totalEl = root.querySelector('[data-vc-cart-total]');
    const countEl = root.querySelector('[data-vc-count]');
    const countText = root.querySelector('[data-vc-count-text]');
    if (totalEl) totalEl.textContent = formatMoney(cart.total_price);
    if (countEl) countEl.textContent = String(cart.item_count);
    if (countText) {
      const n = cart.item_count;
      countText.innerHTML =
        'THERE ' + (n === 1 ? 'IS' : 'ARE') +
        ' <span data-vc-count">' + n + '</span> ' +
        (n === 1 ? 'ITEM' : 'ITEMS') + ' IN YOUR CART';
    }
    updateShippingUI(cart.total_price);

    /* cart bubble */
    document.querySelectorAll('.cart-count-bubble, [data-cart-count], .cart-icon-bubble').forEach((el) => {
      el.textContent = String(cart.item_count);
    });
    document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { cart } }));
  }

  async function changeLine(key, quantity, row) {
    row?.classList.add('is-updating');
    try {
      const res = await fetch(cartChangeUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ id: key, quantity: quantity })
      });
      const cart = await res.json();
      if (cart.status) throw new Error(cart.description || cart.message || 'Cart update failed');

      if (quantity <= 0 || !cart.items.find((i) => i.key === key)) {
        row?.remove();
      } else {
        const item = cart.items.find((i) => i.key === key);
        if (item && row) {
          const qtyInput = row.querySelector('[data-vc-qty-input]');
          const lineTotal = row.querySelector('[data-vc-line-total]');
          if (qtyInput) qtyInput.value = item.quantity;
          if (lineTotal) lineTotal.textContent = formatMoney(item.final_line_price);
        }
        row?.classList.remove('is-updating');
      }

      updateSummary(cart);

      if (!cart.item_count) {
        window.location.reload();
      }
    } catch (err) {
      row?.classList.remove('is-updating');
      alert(err.message || 'Could not update cart');
    }
  }

  root.querySelectorAll('[data-vc-item]').forEach((row) => {
    const key = row.dataset.key;
    const input = row.querySelector('[data-vc-qty-input]');

    row.querySelector('[data-vc-qty-minus]')?.addEventListener('click', () => {
      const q = Math.max(0, (parseInt(input.value, 10) || 1) - 1);
      input.value = q;
      changeLine(key, q, row);
    });

    row.querySelector('[data-vc-qty-plus]')?.addEventListener('click', () => {
      const q = (parseInt(input.value, 10) || 0) + 1;
      input.value = q;
      changeLine(key, q, row);
    });

    input?.addEventListener('change', () => {
      const q = Math.max(0, parseInt(input.value, 10) || 0);
      input.value = q;
      changeLine(key, q, row);
    });

    row.querySelector('[data-vc-remove]')?.addEventListener('click', () => {
      changeLine(key, 0, row);
    });
  });

  /* Cart note */
  let noteTimer;
  root.querySelector('[data-vc-note]')?.addEventListener('input', (e) => {
    clearTimeout(noteTimer);
    noteTimer = setTimeout(() => {
      fetch(cartUpdateUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ note: e.target.value })
      }).catch(() => {});
    }, 500);
  });

  /* Checkout uses native /checkout */
  root.querySelectorAll('[data-vc-checkout]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      /* allow default navigation to checkout */
    });
  });
})();
</script>

